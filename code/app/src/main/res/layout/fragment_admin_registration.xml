<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/tertiaryBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_admin_guard_header"
        style="@style/MainHeaderTextviewStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Admin Registration"
        android:textAlignment="textStart" />

    <TextView
        android:id="@+id/tv_admin_guard_text"
        style="@style/BodyListViewItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Please enter the admin passphrase" />

    <EditText
        android:id="@+id/et_admin_guard_textbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="12dp"
        android:background="@drawable/rounded_edittext"
        android:ems="10"
        android:inputType="text"
        android:padding="8dp"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_admin_guard_cancel"
            style="@style/RoundedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:layout_weight="1"
            android:text="Cancel" />

        <Button
            android:id="@+id/btn_admin_guard_confirm"
            style="@style/RoundedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Confirm" />
    </LinearLayout>
</LinearLayout>