<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground"
    android:paddingTop="32dp"
    tools:context=".Activities.EntrantSettingsActivity">

<!-- Accessibility Switch -->

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/s_accessibility_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:text="Accessibility Mode"
        android:textColor="?attr/android:textColorSecondary"
        android:textSize="12sp"
        android:thumbTint="?attr/colorOnPrimary"
        android:trackTint="?attr/colorPrimary"
        app:layout_constraintBottom_toTopOf="@id/btn_entrant_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Back Button -->
    <ImageButton
        android:id="@+id/btn_entrant_back"
        android:layout_width="51dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/left_arrow" />

    <TextView
        android:id="@+id/tv_settings_title"
        style="@style/MainHeaderTextviewStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="10dp"
        android:text="Settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_save_profile"
        style="@style/RoundedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="Save"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Profile box -->

    <!-- Info box -->
    <LinearLayout
        android:id="@+id/ll_profile_box"
        style="@style/SectionBoxStyle"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_settings_title">

        <ImageView
            android:id="@+id/iv_profile_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:scaleType="centerInside"
            android:src="@drawable/profile_icon" />

        <TextView
            android:id="@+id/iv_profile_header"
            style="@style/MainHeaderTextviewStyle"
            android:layout_gravity="center"
            android:layout_marginTop="6dp"
            android:text="Profile"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_info_box"
        style="@style/SectionBoxStyle"
        android:layout_marginStart="24dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_profile_box">

        <TextView
            style="@style/HeaderRoundedEditTextStyle"
            android:layout_marginBottom="6dp"
            android:text="Edit Name" />

        <EditText
            android:id="@+id/et_name"
            style="@style/BodyRoundedEditTextStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/rounded_edittext"
            android:hint="First Last"
            android:inputType="textPersonName" />

        <TextView
            style="@style/HeaderRoundedEditTextStyle"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:text="Edit Email" />

        <EditText
            android:id="@+id/et_edit_email"
            style="@style/BodyRoundedEditTextStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/rounded_edittext"
            android:hint="example@email.com"
            android:inputType="textEmailAddress" />

        <TextView
            style="@style/HeaderRoundedEditTextStyle"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:text="Edit Phone Number" />

        <EditText
            android:id="@+id/et_edit_phone"
            style="@style/BodyRoundedEditTextStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/rounded_edittext"
            android:hint="XXX-XXX-XXXX"
            android:inputType="phone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_notification_box"
        style="@style/SectionBoxStyle"
        android:layout_marginStart="24dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_info_box">

        <TextView
            android:id="@+id/tv_notifications"
            style="@style/MainHeaderTextviewStyle"
            android:textColor="?attr/android:textColorPrimary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Enable Notifications"
            android:textSize="18sp" />

        <Switch
            android:id="@+id/s_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_sign_out"
        style="@style/RoundedButton"
        android:layout_width="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="24dp"
        android:backgroundTint="?attr/colorSecondary"
        android:text="Sign Out"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_notification_box" />

    <Button
        android:id="@+id/btn_delete_profile"
        style="@style/RoundedButton"
        android:layout_width="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:backgroundTint="?attr/colorSecondary"
        android:text="Delete Profile"
        android:textColor="#FF3333"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_sign_out" />

</androidx.constraintlayout.widget.ConstraintLayout>