<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/primaryBackground"
    tools:context=".EntrantSettingsActivity"
    android:paddingTop="32dp">

    <TextView
        android:id="@+id/tv_settings_title"
        style="@style/MainHeaderTextviewStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:padding="10dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btn_save_profile"
        style="@style/RoundedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Profile box -->
    <LinearLayout
        android:id="@+id/ll_profile_box"
        style="@style/SectionBoxStyle"
        android:orientation="vertical"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_settings_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_profile_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@drawable/profile_icon"
            android:scaleType="centerInside"/>

        <TextView
            android:id="@+id/iv_profile_header"
            style="@style/MainHeaderTextviewStyle"
            android:text="Profile"
            android:textSize="18sp"
            android:layout_gravity="center"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

    <!-- Info box -->
    <LinearLayout
        android:id="@+id/ll_info_box"
        style="@style/SectionBoxStyle"
        android:orientation="vertical"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/ll_profile_box"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            style="@style/HeaderRoundedEditTextStyle"
            android:text="Edit Name"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/et_name"
            style="@style/BodyRoundedEditTextStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/rounded_edittext"
            android:hint="First Last"
            android:inputType="textPersonName"/>

        <TextView
            style="@style/HeaderRoundedEditTextStyle"
            android:text="Edit Email"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/et_edit_email"
            style="@style/BodyRoundedEditTextStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/rounded_edittext"
            android:hint="example@email.com"
            android:inputType="textEmailAddress"/>

        <TextView
            style="@style/HeaderRoundedEditTextStyle"
            android:text="Edit Phone Number"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/et_edit_phone"
            style="@style/BodyRoundedEditTextStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/rounded_edittext"
            android:hint="XXX-XXX-XXXX"
            android:inputType="phone"/>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/ll_notification_box"
        style="@style/SectionBoxStyle"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/ll_info_box"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_notifications"
            style="@style/MainHeaderTextviewStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Enable Notifications"
            android:textSize="18sp" />

        <Switch
            android:id="@+id/s_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <Button
        android:id="@+id/btn_sign_out"
        style="@style/RoundedButton"
        android:layout_width="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="14dp"
        android:text="Sign Out"
        android:backgroundTint="@color/secondaryBackground"
        app:layout_constraintTop_toBottomOf="@id/ll_notification_box"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btn_delete_profile"
        style="@style/RoundedButton"
        android:layout_width="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp"
        android:text="Delete Profile"
        android:textColor="#FF3333"
        android:backgroundTint="@color/secondaryBackground"
        app:layout_constraintTop_toBottomOf="@id/btn_sign_out"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>