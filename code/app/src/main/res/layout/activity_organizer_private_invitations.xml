<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/private_invitations_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryBackground"
    tools:context=".Activities.OrganizerPrivateInvitationsActivity" >

    <TextView
        android:id="@+id/tv_private_invitations_header"
        style="@style/MainHeaderTextviewStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:text="Private Invitations"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/ibtn_private_invitation_back"
        android:layout_width="51dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="10dp"
        android:background="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/left_arrow" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_search_entrant"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_backing_container"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/tv_private_invitations_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            style="@style/HeaderRoundedEditTextStyle"
            android:id="@+id/tv_search_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="17dp"
            android:text="Search:"
            android:textColor="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ToggleButton
            style="@style/ToggleRoundedButton"
            android:id="@+id/tbtn_search_name"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/button_background_selector"
            android:textOff="Name"
            android:textOn="Name"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toTopOf="@id/tv_search_header"
            app:layout_constraintBottom_toBottomOf="@id/tv_search_header"
            app:layout_constraintStart_toEndOf="@id/tv_search_header"/>

        <ToggleButton
            style="@style/ToggleRoundedButton"
            android:id="@+id/tbtn_search_email"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/button_background_selector"
            android:textOff="Email"
            android:textOn="Email"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toTopOf="@id/tv_search_header"
            app:layout_constraintBottom_toBottomOf="@id/tv_search_header"
            app:layout_constraintStart_toEndOf="@id/tbtn_search_name"/>

        <ToggleButton
            style="@style/ToggleRoundedButton"
            android:id="@+id/tbtn_search_phone"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/button_background_selector"
            android:textOff="Phone"
            android:textOn="Phone"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toTopOf="@id/tv_search_header"
            app:layout_constraintBottom_toBottomOf="@id/tv_search_header"
            app:layout_constraintStart_toEndOf="@id/tbtn_search_email"/>

        <EditText
            style="@style/BodyRoundedEditTextStyle"
            android:id="@+id/et_search_entrant"
            android:layout_width="325dp"
            android:layout_height="30dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/rounded_edittext"
            android:hint="Enter Entrant Information"
            app:layout_constraintTop_toBottomOf="@id/tbtn_search_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            style="@style/RoundedButton"
            android:id="@+id/btn_search_confirm"
            android:layout_width="150dp"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="@color/secondaryAccent"
            android:text="Confirm"
            android:textColor="@color/primaryBackground"
            app:layout_constraintTop_toBottomOf="@id/et_search_entrant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_search_clear" />

        <Button
            style="@style/RoundedButton"
            android:id="@+id/btn_search_clear"
            android:layout_width="150dp"
            android:layout_height="40dp"
            android:backgroundTint="@color/grey"
            android:text="Clear"
            android:textColor="@color/primaryBackground"
            app:layout_constraintTop_toTopOf="@id/btn_search_confirm"
            app:layout_constraintBottom_toBottomOf="@id/btn_search_confirm"
            app:layout_constraintStart_toEndOf="@id/btn_search_confirm"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ListView
        android:id="@+id/lv_entrants_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:divider="@null"
        android:dividerHeight="12dp"
        app:layout_constraintTop_toBottomOf="@id/cl_search_entrant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/cl_search_entrant"
        app:layout_constraintEnd_toEndOf="@id/cl_search_entrant" />

</androidx.constraintlayout.widget.ConstraintLayout>