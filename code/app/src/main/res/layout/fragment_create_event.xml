<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorOnBackground"
    tools:context=".CreateEventDialogFragment">


    <TextView
        android:id="@+id/textView"
        style="@style/MainHeaderTextviewStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create Event"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_edit_name_header"
        style="@style/HeaderRoundedEditTextStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Name"
        app:layout_constraintBottom_toTopOf="@+id/et_event_edit_name"
        app:layout_constraintEnd_toEndOf="@+id/et_event_edit_name"
        app:layout_constraintHorizontal_bias="0.044"
        app:layout_constraintStart_toStartOf="@+id/et_event_edit_name" />

    <EditText
        android:id="@+id/et_event_edit_name"
        style="@style/BodyRoundedEditTextStyle"
        android:layout_width="325dp"
        android:layout_height="35dp"
        android:layout_marginTop="45dp"
        android:background="@drawable/rounded_edittext"
        android:hint="Enter a name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <TextView
        android:id="@+id/tv_edit_registration_period"
        style="@style/HeaderRoundedEditTextStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Registration Period"
        app:layout_constraintBottom_toTopOf="@+id/et_event_edit_registration_start"
        app:layout_constraintEnd_toEndOf="@+id/et_event_edit_registration_start"
        app:layout_constraintHorizontal_bias="0.044"
        app:layout_constraintStart_toStartOf="@+id/et_event_edit_registration_start" />

    <EditText
        android:id="@+id/et_event_edit_registration_start"
        style="@style/BodyRoundedEditTextStyle"
        android:layout_width="125dp"
        android:layout_height="35dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/rounded_edittext"
        android:hint="Someday, Jan 23"
        android:inputType="date"
        android:textAlignment="center"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@+id/et_event_edit_name"
        app:layout_constraintTop_toBottomOf="@+id/et_event_edit_name" />

    <EditText
        android:id="@+id/et_event_edit_registration_end"
        style="@style/BodyRoundedEditTextStyle"
        android:layout_width="125dp"
        android:layout_height="35dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/rounded_edittext"
        android:hint="Someday, Jan 30"
        android:inputType="date"
        android:textAlignment="center"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@+id/et_event_edit_name"
        app:layout_constraintTop_toBottomOf="@+id/et_event_edit_name" />

    <TextView
        android:id="@+id/tv_edit_to"
        style="@style/DefaultTextStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="To"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/et_event_edit_registration_end"
        app:layout_constraintEnd_toStartOf="@+id/et_event_edit_registration_end"
        app:layout_constraintStart_toEndOf="@+id/et_event_edit_registration_start"
        app:layout_constraintTop_toTopOf="@+id/et_event_edit_registration_end" />

    <TextView
        android:id="@+id/tv_edit_draw_date"
        style="@style/HeaderRoundedEditTextStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start Date"
        app:layout_constraintBottom_toTopOf="@+id/et_event_edit_draw_date"
        app:layout_constraintEnd_toEndOf="@+id/et_event_edit_draw_date"
        app:layout_constraintHorizontal_bias="0.05"
        app:layout_constraintStart_toStartOf="@+id/et_event_edit_draw_date" />

    <EditText
        android:id="@+id/et_event_edit_draw_date"
        style="@style/BodyRoundedEditTextStyle"
        android:layout_width="125dp"
        android:layout_height="35dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/rounded_edittext"
        android:hint="Someday, Jan 31"
        android:inputType="date"
        android:textAlignment="center"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@+id/et_event_edit_registration_start"
        app:layout_constraintTop_toBottomOf="@+id/et_event_edit_registration_start" />

    <EditText
        android:id="@+id/et_event_edit_draw_time"
        style="@style/BodyRoundedEditTextStyle"
        android:layout_width="125dp"
        android:layout_height="35dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/rounded_edittext"
        android:hint="9:00"
        android:inputType="time"
        android:textAlignment="center"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@+id/et_event_edit_registration_end"
        app:layout_constraintTop_toBottomOf="@+id/et_event_edit_registration_end" />

    <TextView
        android:id="@+id/tv_edit_at"
        style="@style/DefaultTextStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="At"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/et_event_edit_draw_time"
        app:layout_constraintEnd_toStartOf="@+id/et_event_edit_draw_time"
        app:layout_constraintStart_toEndOf="@+id/et_event_edit_draw_date"
        app:layout_constraintTop_toTopOf="@+id/et_event_edit_draw_time" />

    <TextView
        android:id="@+id/tv_edit_entrant_limit"
        style="@style/HeaderRoundedEditTextStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Entrant Limit"
        app:layout_constraintBottom_toTopOf="@+id/et_event_edit_entrant_limit"
        app:layout_constraintEnd_toEndOf="@+id/et_event_edit_entrant_limit"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/et_event_edit_entrant_limit" />

    <EditText
        android:id="@+id/et_event_edit_entrant_limit"
        style="@style/BodyRoundedEditTextStyle"
        android:layout_width="125dp"
        android:layout_height="35dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/rounded_edittext"
        android:inputType="number"
        android:text="30"
        android:textAlignment="center"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@+id/et_event_edit_draw_date"
        app:layout_constraintTop_toBottomOf="@+id/et_event_edit_draw_date" />

    <LinearLayout
        android:id="@+id/ll_isPrivate_container"
        android:layout_width="325dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/rounded_edittext"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_event_edit_entrant_limit">


        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_create_isPrivate"
            style="@style/BodyRoundedEditTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:background="@color/transparent"
            android:paddingStart="0dp"
            android:text="Make Event Private"
            android:textColor="?attr/android:textColorSecondary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_isPrivate_hint"
            style="@style/DefaultTextStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-16dp"
            android:layout_marginBottom="4dp"
            android:text="Only Entrants you invite can join the waitlist"
            android:textColor="@color/grey"
            android:textSize="11sp"
            android:textStyle="normal" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_location_Enabled_container"
        android:layout_width="325dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/rounded_edittext"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_isPrivate_container">


        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_create_needLocation"
            style="@style/BodyRoundedEditTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:background="@color/transparent"
            android:paddingStart="0dp"
            android:text="Enable Geolocation"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_needLocation_hint"
            style="@style/DefaultTextStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-16dp"
            android:layout_marginBottom="4dp"
            android:text="Only Entrants with geolocation enabled can join the waitlist"
            android:textColor="@color/grey"
            android:textSize="11sp"
            android:textStyle="normal" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_event_edit_confirm"
        style="@style/RoundedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:backgroundTint="?attr/colorSurface"
        android:text="Confirm"
        android:textColor="?attr/colorOnSecondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_location_Enabled_container" />

</androidx.constraintlayout.widget.ConstraintLayout>