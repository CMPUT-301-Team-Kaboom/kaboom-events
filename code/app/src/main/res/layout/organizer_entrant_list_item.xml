<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/secondaryBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_organizer_entrantList_item_number"
            style="@style/MainHeaderTextviewStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:text="1" />

        <ImageView
            android:id="@+id/iv_organizer_entrantList_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/rounded_container"
            android:padding="6dp"
            app:srcCompat="@drawable/profile_icon" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_organizer_entrantList_item_name"
                style="@style/HeaderListViewItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="First Last" />

            <TextView
                android:id="@+id/tv_organizer_entrantList_item_email"
                style="@style/BodyListViewItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="example@ualberta.ca" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/organizer_entrantList_horizontal_line"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="10dp"
        android:background="@color/primaryAccent"
        app:layout_constraintBottom_toTopOf="@id/bn_events_list_menu"
        app:layout_constraintTop_toBottomOf="@id/fl_events_list" />

</LinearLayout>