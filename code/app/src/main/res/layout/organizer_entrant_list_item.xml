<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/secondaryBackground"
    android:paddingBottom="8dp">

    <!-- Row Content Container -->
    <LinearLayout
        android:id="@+id/ll_entrant_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_toStartOf="@+id/cb_entrant_select"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_organizer_entrantList_item_number"
            style="@style/MainHeaderTextviewStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="1" />

        <ImageView
            android:id="@+id/iv_organizer_entrantList_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/rounded_container"
            android:padding="6dp"
            app:srcCompat="@drawable/profile_icon" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_organizer_entrantList_item_name"
                style="@style/HeaderListViewItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="First Last" />

            <TextView
                android:id="@+id/tv_organizer_entrantList_item_email"
                style="@style/BodyListViewItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="example@ualberta.ca" />
        </LinearLayout>
    </LinearLayout>

    <!-- The Checkbox: Anchored to the Right and Centered Vertically -->
    <CheckBox
        android:id="@+id/cb_entrant_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:buttonTint="@color/white"
        android:scaleX="1.5"
        android:scaleY="1.5"
        android:visibility="gone" />

    <!-- Divider Line -->
    <View
        android:id="@+id/organizer_entrantList_horizontal_line"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@id/ll_entrant_data"
        android:layout_marginTop="10dp"
        android:background="@color/primaryAccent" />

</RelativeLayout>