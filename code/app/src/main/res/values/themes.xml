<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ProjectEventLotteryApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primaryAccent</item>
        <item name="colorOnPrimary">@color/white</item>
        <!--    Affects datePicker header    -->
        <item name="colorSecondary">@color/secondaryBackground</item>
        <item name="colorOnSecondary">@color/primaryBackground</item>
        <item name="colorTertiary">@color/tertiaryAccent</item>
        <item name="android:windowBackground">@color/primaryBackground</item>
        <item name="colorOnSurface">@color/lightGrey</item>
        <item name="colorSurface">@color/secondaryBackground</item>
        <item name="colorOnBackground">@color/tertiaryBackground</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white</item>
    </style>

    <style name="Theme.ProjectEventLotteryApp.Accessibility" parent="Base.Theme.ProjectEventLotteryApp">
        <item name="colorPrimary">@color/accessibilityPrimary</item>
        <item name="colorOnPrimary">@color/accessibilityOnPrimary</item>
        <item name="colorSecondary">@color/accessibilityPrimary</item>
        <item name="colorOnSecondary">@color/accessibilityOnPrimary</item>
        <item name="android:windowBackground">@color/accessibilityBackground</item>
        <item name="colorSurface">@color/accessibilitySurface</item>
        <item name="colorOnSurface">@color/accessibilityOnPrimary</item>
        <item name="colorOnBackground">@color/accessibilityBackground</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/accessibilityPrimary</item>
        <item name="colorTertiary">@color/lightGrey</item>"
    </style>
</resources>